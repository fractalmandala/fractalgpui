{
	"name": "fractalgpui",
	"private": true,
	"version": "0.0.0",
	"description": "Fractal workbench: native GPUI desktop tools in Svelte 5 (gpuix-svelte), styled by fractalstyler",
	"type": "module",
	"scripts": {
		"start": "gpuix-svelte --bun app.ts",
		"test": "gpuix-svelte --bun test.ts",
		"typecheck": "tsc --noEmit",
		"audit:classes": "gpuix-svelte --bun build/audit-classes.ts --write",
		"dist:dmg": "bun build/dmg.ts"
	},
	"dependencies": {
		"gpuix-svelte": "git+https://github.com/khromov/gpuix-svelte.git#7e6074dfdc387a62f9bf053bcb9439de6bdad019",
		"svelte": "file:vendor/svelte-5.57.0-ff9658a.tgz"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"sass": "^1.105.1",
		"typescript": "^5.9.3"
	}
}
