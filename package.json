{
	"name": "fractalgpui",
	"private": true,
	"version": "0.0.0",
	"description": "Fractal workbench: native GPUI desktop tools in Svelte 5 (gpuix-svelte), styled by fractalstyler",
	"type": "module",
	"scripts": {
		"start": "gpuix-svelte --bun app.ts",
		"test": "gpuix-svelte --bun test.ts",
		"typecheck": "tsc --noEmit",
		"audit:classes": "gpuix-svelte --bun build/audit-classes.ts --write",
		"convert:react": "bun build/convert-react-folder.ts",
		"dist:dmg": "bun build/dmg.ts"
	},
	"dependencies": {
		"@babel/generator": "^8.0.6",
		"@babel/parser": "^8.0.6",
		"@babel/traverse": "^8.0.6",
		"@babel/types": "^8.0.6",
		"@earendil-works/chord": "1.0.2",
		"@earendil-works/pi-ai": "1.0.2",
		"@earendil-works/pi-durable": "1.0.2",
		"gpuix-svelte": "file:vendor/gpuix-svelte",
		"svelte": "file:vendor/svelte"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"sass": "^1.105.1",
		"typescript": "^5.9.3"
	},
	"allowScripts": {
		"@google/genai@2.21.0": true,
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true,
		"protobufjs@7.6.6": true
	}
}
